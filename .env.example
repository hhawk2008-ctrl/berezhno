# Адрес сайта
SITE_DOMAIN=steady-me.ru

# Почта для Let's Encrypt (письма о проблемах с сертификатом https)
ACME_EMAIL=privet@steady-me.ru

# Доступ к API REG.RU — нужен, чтобы получать сертификат https (шаг 15 инструкции).
# Логин от личного кабинета REG.RU и альтернативный пароль из «Настроек API».
REGRU_USERNAME=
REGRU_PASSWORD=

# Пароль базы данных. Скрипт установки придумает его сам — оставьте пустым.
POSTGRES_PASSWORD=

# YandexGPT (шаг 4 инструкции). Понадобится позже, пока можно не заполнять.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
